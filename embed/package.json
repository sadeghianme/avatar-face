{
  "name": "@liveface/embed",
  "version": "0.1.0",
  "private": true,
  "description": "Liveface embeddable talking-avatar widget + canvas engine",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "typecheck": "tsc -b",
    "build": "tsc -b && esbuild src/widget.ts --bundle --format=iife --outfile=dist/liveface.js --minify",
    "dev": "esbuild src/widget.ts --bundle --format=iife --outfile=dist/liveface.js --watch --servedir=."
  },
  "devDependencies": {
    "esbuild": "^0.21.5",
    "typescript": "^5.4.5"
  }
}
