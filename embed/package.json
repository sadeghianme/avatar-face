{
  "name": "@liveface/embed",
  "version": "0.1.0",
  "private": true,
  "description": "Liveface embeddable talking-avatar widget + canvas engine",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "typecheck": "tsc -b && tsc -p tsconfig.test.json",
    "lint": "eslint .",
    "build": "tsc -b && node scripts/build.mjs && cp assets/mouth-motion.json assets/mouth-teeth.webp assets/mouth-teeth.rig.json dist/",
    "dev": "esbuild src/widget.ts --bundle --format=iife --outfile=dist/liveface.js --watch --servedir=.",
    "build:head3d-bake": "esbuild scripts/head3d-bake.ts --bundle --platform=node --format=esm --outfile=dist/head3d-bake.mjs",
    "build:head3d-harness": "esbuild src/head3d/harness/harness.ts --bundle --format=iife --outfile=dist/head3d-harness.js",
    "test": "vitest run",
    "test:pixels": "vitest run src/__tests__/pixels.test.ts",
    "test:pixels:update": "UPDATE_PIXEL_GOLDENS=1 vitest run src/__tests__/pixels.test.ts",
    "test:pixels:add-platform": "UPDATE_PIXEL_GOLDENS=hashes vitest run src/__tests__/pixels.test.ts",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:browser:update": "UPDATE_BROWSER_GOLDENS=1 vitest run --config vitest.browser.config.ts browser-tests/gl-warp.test.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@napi-rs/canvas": "^1.0.10",
    "@types/node": "^20.19.43",
    "esbuild": "^0.21.5",
    "eslint": "^10.12.0",
    "playwright": "1.63.0",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.71.1",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "@types/three": "^0.184.1",
    "three": "^0.184.0"
  }
}
