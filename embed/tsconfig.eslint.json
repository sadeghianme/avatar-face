{
  // The program ESLint's type-aware rules read: the build's, plus what the
  // build leaves out (the tests, the bake script). Never emits.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "rootDir": "."
  },
  "include": ["src", "scripts"],
  "exclude": []
}
