{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@liveface/embed": ["../embed/src/index.ts"],
      "@liveface/embed/*": ["../embed/src/*"]
    }
  },
  "include": ["src", "../embed/src"],
  // The embed package's tests are vitest-only and pull in Node types the
  // dashboard does not have; they are typechecked by `npm test` in embed.
  "exclude": ["../embed/src/__tests__"]
}
