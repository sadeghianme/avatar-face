# Liveface backend configuration.
# EVERYTHING is optional — with no .env at all the app runs on SQLite,
# local-filesystem storage, and the built-in offline TTS provider.

# --- Core ---
# APP_NAME=Liveface
# ENVIRONMENT=development
# DEBUG=false
# Public origin of this API. Embedded third-party pages load textures/audio
# from absolute URLs built on this base — set it to your real domain in prod.
# PUBLIC_BASE_URL=http://localhost:7002

# --- Database ---
# Default: SQLite file next to the backend package.
# DATABASE_URL=sqlite+aiosqlite:///./liveface.sqlite3
# Postgres (e.g. the docker-compose service on port 7003):
# DATABASE_URL=postgresql+asyncpg://liveface:liveface@localhost:7003/liveface

# --- Auth ---
# CHANGE THIS in any real deployment (also signs local-storage URLs):
# JWT_SECRET=dev-only-change-me
# ACCESS_TOKEN_MINUTES=15
# REFRESH_TOKEN_DAYS=30
# Dashboard sessions (docs/process.md, "Sessions"). The refresh cookie's
# path, as the dashboard reaches the auth routes (behind /api):
# SESSION_COOKIE_PATH=/api/auth
# Secure on the session cookies; unset, it follows APP_BASE_URL (https: on).
# SESSION_COOKIE_SECURE=
# A spent refresh token presented again within this many seconds gets the
# same next token (a lost answer, two tabs); later, the session is revoked.
# REFRESH_REUSE_GRACE_SECONDS=10

# --- Client addresses behind proxies (app/core/client_ip.py) ---
# What every per-client rate limit is keyed on. Unset: the TCP peer.
# Reverse proxies in front of the API (CIDRs); the rightmost X-Forwarded-For
# entry is believed only from a peer in one of them:
# TRUSTED_PROXIES=172.16.0.0/12,10.0.0.0/8,192.168.0.0/16
# TRUSTED_PROXY_HOPS=1
# Behind Cloudflare: believe CF-Connecting-IP from its published ranges.
# TRUST_CLOUDFLARE=false

# --- CORS (dashboard origins; comma-separated CSV, JSON list also accepted) ---
# CORS_ORIGINS=http://localhost:5174

# --- Object storage (Cloudflare R2 / any S3) ---
# All three set => S3 mode; otherwise the HMAC-signed local-filesystem
# fallback under LOCAL_STORAGE_DIR is used (served by /storage).
# R2_ENDPOINT=http://localhost:7004        # MinIO from docker-compose
# R2_ACCESS_KEY=liveface
# R2_SECRET=liveface-secret
# R2_BUCKET=liveface
# R2_REGION=auto
# LOCAL_STORAGE_DIR=./local_storage
# PRESIGN_EXPIRY_SECONDS=3600

# --- Uploads ---
# ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp
# MAX_UPLOAD_BYTES=10485760

# --- Rig ---
# Path to a MediaPipe FaceLandmarker .task model. Unset => synthetic mesh
# (fine for stock avatars; looks wrong on real photos — set this in prod).
# Download: https://storage.googleapis.com/mediapipe-models/face_landmarker/face_landmarker/float16/latest/face_landmarker.task
# RIG_MODEL_PATH=./models/face_landmarker.task

# --- TTS provider keys (env-level; dashboard-managed keys override these) ---
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=westeurope
# ELEVENLABS_API_KEY=
# GOOGLE_TTS_CREDENTIALS_JSON=             # inline JSON or a file path
# OPENAI_API_KEY=

# --- Credential encryption ---
# Fernet key for provider credentials at rest. Unset => derived from
# JWT_SECRET. Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# CREDENTIAL_ENCRYPTION_KEY=

# --- Embed API ---
# EMBED_RATE_LIMIT_PER_MINUTE=60

# --- Speech cache (app/services/tts/speech_cache.py) ---
# Lines spoken are kept in storage as MP3; least recently used go first past
# either cap (bytes). A cloned voice's lines are never evicted.
# SPEECH_CACHE_MAX_BYTES=2147483648
# SPEECH_CACHE_ORG_MAX_BYTES=268435456
# SPEECH_CACHE_MAX_IDLE_DAYS=90            # 0 keeps unused lines
# SPEECH_CACHE_MP3_LEVEL=0.5               # VBR level, 0 best .. 1 smallest

# --- Usage ---
# MONTHLY_CHAR_LIMIT=100000
